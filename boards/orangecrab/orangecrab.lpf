SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE;

LOCATE COMP "clk" SITE "A9";
IOBUF  PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 48.0 MHz;

LOCATE COMP "reset" SITE "J17"; # btn0
IOBUF  PORT "reset" IO_TYPE=SSTL135_I;

LOCATE COMP "uart_tx" SITE "N17";  # gpio_0
IOBUF  PORT "uart_tx" PULLMODE=DOWN IO_TYPE=LVCMOS33;
LOCATE COMP "uart_rx" SITE "M18";  # gpio_1
IOBUF  PORT "uart_rx" PULLMODE=DOWN IO_TYPE=LVCMOS33;
