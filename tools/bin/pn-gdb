import os
import time
import sys
import subprocess
import signal
import argparse

def start_openocd(openocd_config_path:str):
    command = ["openocd", "-f", f"{openocd_config_path}"]
    oocd_process = subprocess.Popen(
        command, 
        process_group=0,
        stdout=subprocess.DEVNULL, 
        stderr=subprocess.DEVNULL)

    return oocd_process

def start_riscv_gdb(gdb_config_path:str, application_path:str):
    working_dir, gdb_config_name = os.path.split(gdb_config_path)
    command = [
        "riscv64-unknown-elf-gdb", 
        f"--command={gdb_config_name}", 
        application_path]

    process = subprocess.Popen(
            command,
            cwd=working_dir) 
    process.wait()

if __name__ == "__main__":

    script_dir = os.path.dirname(os.path.abspath(__file__))
    base_dir = os.path.normpath(os.path.join(script_dir, "../../"))
    etc_dir = os.path.join(base_dir, "tools", "etc")

    #
    # Parse Argument
    #
    parser = argparse.ArgumentParser(description="Script with optional arguments --sim and --board.")

    parser.add_argument(
        "--sim",
        action="store_true",
        default=True,
        help="Enable simulation mode (default)."
    )
    parser.add_argument(
        "--board",
        action="store_true",
        help="Enable board mode."
    )
    parser.add_argument(
        "app_path",
        type=str,
        help="Path to application"
    )

    args = parser.parse_args()

    
    openocd_config_path = ""
    if args.board:
        openocd_config_path = os.path.join(etc_dir, "openocd-board.cfg")
    else:
        openocd_config_path = os.path.join(etc_dir, "openocd-sim.cfg")

    gdb_config_path = os.path.join(etc_dir, "gdb_start") 
    app_path = os.path.abspath(args.app_path)

    #
    # Start Tools
    #
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    
    oocd_process = start_openocd(openocd_config_path)
    time.sleep(1)

    process = start_riscv_gdb(gdb_config_path, app_path)

    oocd_process.kill()

    print("GDB and OpenOCD closed successfully!")
